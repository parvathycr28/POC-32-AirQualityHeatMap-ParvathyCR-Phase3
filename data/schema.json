{
  "schema_name": "Infocreon Canonical Intelligence Data Schema",
  "schema_version": "1.1",
  "data_version": "phase3-v1.1",
  "description": "Canonical 20-column schema for the Aether Pulse Phase 3 air-quality intelligence dataset.",
  "columns": [
    {
      "name": "record_id",
      "type": "string",
      "required": true,
      "nullable": false,
      "description": "Unique canonical record identifier.",
      "provenance": {
        "kind": "derived",
        "source_field": null,
        "derivation": "Generated deterministically from canonical row order."
      },
      "constraints": {
        "unique": true
      }
    },
    {
      "name": "record_type",
      "type": "string",
      "required": true,
      "nullable": false,
      "description": "Type of intelligence record.",
      "provenance": {
        "kind": "derived",
        "source_field": null,
        "derivation": "Assigned as measurement for air-quality observations."
      },
      "allowed_values": [
        "measurement"
      ]
    },
    {
      "name": "observed_at",
      "type": "datetime",
      "required": false,
      "nullable": true,
      "description": "Observation timestamp in UTC.",
      "provenance": {
        "kind": "source",
        "source_field": "timestamp",
        "derivation": "Parsed and normalized to UTC ISO-8601 format."
      }
    },
    {
      "name": "entity_id",
      "type": "string",
      "required": false,
      "nullable": true,
      "description": "Normalized city/entity identifier.",
      "provenance": {
        "kind": "derived",
        "source_field": "city",
        "derivation": "Lowercase normalized city identifier."
      }
    },
    {
      "name": "related_entity_id",
      "type": "string",
      "required": false,
      "nullable": true,
      "description": "Related entity identifier when applicable.",
      "provenance": {
        "kind": "derived",
        "source_field": null,
        "derivation": "Null when no related entity exists."
      }
    },
    {
      "name": "entity_name",
      "type": "string",
      "required": false,
      "nullable": true,
      "description": "Human-readable city/entity name.",
      "provenance": {
        "kind": "source",
        "source_field": "city",
        "derivation": "Trimmed source city value."
      }
    },
    {
      "name": "category",
      "type": "string",
      "required": false,
      "nullable": true,
      "description": "Top-level intelligence category.",
      "provenance": {
        "kind": "derived",
        "source_field": null,
        "derivation": "Assigned as air_quality."
      },
      "allowed_values": [
        "air_quality"
      ]
    },
    {
      "name": "subcategory",
      "type": "string",
      "required": false,
      "nullable": true,
      "description": "Pollutant-specific subcategory.",
      "provenance": {
        "kind": "source",
        "source_field": "pollutant",
        "derivation": "Normalized pollutant name."
      },
      "allowed_values": [
        "pm2.5",
        "pm10",
        "no2",
        "o3"
      ]
    },
    {
      "name": "status",
      "type": "string",
      "required": false,
      "nullable": true,
      "description": "Observation status.",
      "provenance": {
        "kind": "derived",
        "source_field": null,
        "derivation": "Assigned as observed."
      },
      "allowed_values": [
        "observed"
      ]
    },
    {
      "name": "stage",
      "type": "string",
      "required": false,
      "nullable": true,
      "description": "Observation processing stage.",
      "provenance": {
        "kind": "derived",
        "source_field": null,
        "derivation": "Assigned as observation."
      },
      "allowed_values": [
        "observation"
      ]
    },
    {
      "name": "metric_name",
      "type": "string",
      "required": false,
      "nullable": true,
      "description": "Measured pollutant metric.",
      "provenance": {
        "kind": "source",
        "source_field": "pollutant",
        "derivation": "Normalized pollutant name."
      },
      "allowed_values": [
        "pm2.5",
        "pm10",
        "no2",
        "o3"
      ]
    },
    {
      "name": "metric_value",
      "type": "number",
      "required": false,
      "nullable": true,
      "description": "Measured pollutant value.",
      "provenance": {
        "kind": "source",
        "source_field": "value",
        "derivation": "Converted to numeric value."
      },
      "constraints": {
        "minimum": 0
      }
    },
    {
      "name": "metric_unit",
      "type": "string",
      "required": false,
      "nullable": true,
      "description": "Unit of the measured pollutant value.",
      "provenance": {
        "kind": "source",
        "source_field": "unit",
        "derivation": "Preserved from source sample."
      },
      "allowed_values": [
        "µg/m³"
      ]
    },
    {
      "name": "text_value",
      "type": "string",
      "required": false,
      "nullable": true,
      "description": "Associated country or textual context.",
      "provenance": {
        "kind": "source",
        "source_field": "country",
        "derivation": "Preserved as textual context."
      }
    },
    {
      "name": "latitude",
      "type": "number",
      "required": false,
      "nullable": true,
      "description": "Latitude coordinate in WGS84.",
      "provenance": {
        "kind": "source",
        "source_field": "latitude",
        "derivation": "Converted to numeric WGS84 coordinate."
      },
      "constraints": {
        "minimum": -90,
        "maximum": 90
      }
    },
    {
      "name": "longitude",
      "type": "number",
      "required": false,
      "nullable": true,
      "description": "Longitude coordinate in WGS84.",
      "provenance": {
        "kind": "source",
        "source_field": "longitude",
        "derivation": "Converted to numeric WGS84 coordinate."
      },
      "constraints": {
        "minimum": -180,
        "maximum": 180
      }
    },
    {
      "name": "source_name",
      "type": "string",
      "required": true,
      "nullable": false,
      "description": "Origin or provenance label for the source record.",
      "provenance": {
        "kind": "source",
        "source_field": "source",
        "derivation": "Explicitly identifies the controlled synthetic OpenAQ-shaped source."
      },
      "allowed_values": [
        "Synthetic OpenAQ-shaped sample"
      ]
    },
    {
      "name": "source_record_id",
      "type": "string",
      "required": false,
      "nullable": true,
      "description": "Stable identifier assigned to the source-level observation.",
      "provenance": {
        "kind": "derived",
        "source_field": null,
        "derivation": "Generated from city, pollutant and row sequence."
      }
    },
    {
      "name": "is_synthetic",
      "type": "boolean",
      "required": true,
      "nullable": false,
      "description": "Whether the record is synthetic.",
      "provenance": {
        "kind": "derived",
        "source_field": null,
        "derivation": "True because the controlled Phase 3 source is synthetic."
      },
      "allowed_values": [
        true,
        false
      ]
    },
    {
      "name": "data_version",
      "type": "string",
      "required": true,
      "nullable": false,
      "description": "Canonical dataset version.",
      "provenance": {
        "kind": "derived",
        "source_field": null,
        "derivation": "Assigned by the Phase 3 canonical pipeline."
      },
      "allowed_values": [
        "phase3-v1.1"
      ]
    }
  ]
}