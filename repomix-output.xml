              onClose={() =>
                setIntelligenceOpen(
                  false,
                )
              }
              loading={loading}
              selectedCity={
                selectedCity
              }
            />
          </div>
        </div>
      )}

      {/* =====================================================
          SELECTED CITY INDICATOR
          ===================================================== */}

      {selectedCity &&
        !intelligenceOpen && (
          <button
            type="button"
            onClick={() =>
              setIntelligenceOpen(
                true,
              )
            }
