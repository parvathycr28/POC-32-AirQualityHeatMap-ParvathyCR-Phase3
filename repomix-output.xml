          >

            <MapPin className="h-4 w-4" />

            {selectedCity}

            <span
              role="button"
              tabIndex={0}
              aria-label="Clear selected city"
              onClick={(event) => {
                event.stopPropagation();

                setSelectedCity("");
              }}
              onKeyDown={(event) => {
                if (
                  event.key ===
                    "Enter" ||
                  event.key ===
                    " "
                ) {
                  event.preventDefault();

                  event.stopPropagation();

                  setSelectedCity("");
                }
              }}
              className="rounded-full p-1 transition hover:bg-white/10"
            >
              <X className="h-4 w-4" />
            </span>
          </button>
        )}
    </main>
  );
}
