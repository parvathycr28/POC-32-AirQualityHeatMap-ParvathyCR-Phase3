}

/* Glass surface */

.rr-glass {
  background: rgba(11, 17, 23, 0.88);
  border: 1px solid #1f2937;
  backdrop-filter: blur(14px);
}

/* Utility */

.rr-muted {
  color: #8ba3b0;
}

.rr-cyan {
  color: #38bdf8;
}

.rr-indigo {
  color: #818cf8;
}
/* =========================================================
   REAL RAILS - CINEMATIC LEAFLET BASEMAP
   Darkens ONLY the map tile layer.
   Markers, controls and popups remain unaffected.
   ========================================================= */

.leaflet-container {
  background: #030712 !important;
}

.leaflet-tile-pane {
  filter:
    brightness(0.98)
    invert(0.92)
    contrast(1.15)
    saturate(0.35)
    hue-rotate(180deg);
}
/* =========================================================
   REAL RAILS - COMPACT DARK CITY POPUP
   ========================================================= */

.leaflet-popup-content-wrapper {
  background: #0B1117 !important;
  color: #E5F3F8 !important;
  border: 1px solid #26384A !important;
  border-radius: 10px !important;
  box-shadow: 0 12px 30px rgba(0, 0, 0, 0.65) !important;
}

/* Popup arrow */
.leaflet-popup-tip {
  background: #0B1117 !important;
}

/* Smaller popup */
.leaflet-popup-content {
  width: 240px !important;
  max-width: 240px !important;
  margin: 12px 14px !important;
}

/* Close button */
.leaflet-popup-close-button {
  color: #E5F3F8 !important;
  font-size: 20px !important;
  font-weight: 600 !important;
  padding: 6px 8px 0 0 !important;
}

.leaflet-popup-close-button:hover {
  color: #38BDF8 !important;
}

/* Popup text */
.leaflet-popup-content p {
  margin: 0 !important;
}

/* Labels */
.leaflet-popup-content .popup-label {
  color: #94AFC0 !important;
  font-size: 11px !important;
}

/* Main values */
.leaflet-popup-content .popup-value {
  color: #F1F5F9 !important;
  font-size: 14px !important;
  font-weight: 500 !important;
}

/* Cyan highlighted values */
.leaflet-popup-content .popup-accent {
  color: #38BDF8 !important;
  font-weight: 600 !important;
}

/* City name */
.leaflet-popup-content .popup-title {
  color: #F8FAFC !important;
  font-size: 16px !important;
  font-weight: 700 !important;
  line-height: 1.25 !important;
}

/* Air Quality heading */
.leaflet-popup-content .popup-heading {
  color: #38BDF8 !important;
  font-size: 10px !important;
  font-weight: 600 !important;
  letter-spacing: 0.12em !important;
  text-transform: uppercase !important;
}

/* Load population */
.leaflet-popup-content button {
