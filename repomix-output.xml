                  color:
                    "bg-yellow-400",
                  range: "12 - 35",
                  label: "Moderate",
                },
                {
                  color:
                    "bg-orange-400",
                  range: "35 - 55",
                  label:
                    "Unhealthy (SG)",
                },
                {
                  color:
                    "bg-red-500",
                  range: "55 - 150",
                  label: "Unhealthy",
                },
                {
                  color:
                    "bg-purple-500",
                  range: "150+",
                  label:
                    "Very Unhealthy",
                },
              ].map(
                (item) => (
                  <div
                    key={item.range}
                    className="flex items-center gap-2"
                  >
                    <span
                      className={`h-3.5 w-3.5 rounded-full ${item.color} border border-white/30`}
                    />

                    <span className="text-slate-200">
                      {item.range}
                    </span>

                    <span className="ml-auto text-[10px] text-slate-500">
                      {item.label}
                    </span>
                  </div>
