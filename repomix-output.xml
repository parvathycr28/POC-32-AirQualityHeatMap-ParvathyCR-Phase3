async def get_worldpop_population(
    latitude: float,
    longitude: float,
) -> float | None:

    delta = 0.025

    geojson = {
        "type": "FeatureCollection",
        "features": [
            {
                "type": "Feature",
                "properties": {},
                "geometry": {
                    "type": "Polygon",
                    "coordinates": [
                        [
                            [
                                longitude - delta,
                                latitude - delta,
                            ],
                            [
                                longitude + delta,
                                latitude - delta,
                            ],
                            [
                                longitude + delta,
                                latitude + delta,
                            ],
                            [
                                longitude - delta,
                                latitude + delta,
                            ],
                            [
                                longitude - delta,
                                latitude - delta,
                            ],
                        ]
                    ],
                },
            }
        ],
    }

    params = {
        "dataset": "wpgppop",
        "year": WORLDPOP_YEAR,
        "geojson": json.dumps(geojson),
        "runasync": "false",
    }

    try:
        async with httpx.AsyncClient(
            timeout=60
        ) as client:

            response = await client.get(
                WORLDPOP_URL,
                params=params,
            )

            print(
                "WORLDPOP STATUS:",
                response.status_code,
            )

            print(
                "WORLDPOP RESPONSE:",
                response.text[:5000],
            )

            response.raise_for_status()

            data = response.json()

        if data.get("error"):
            print(
                "WORLDPOP ERROR:",
                data.get("error_message"),
            )

            return None

        population = (
            data
            .get("data", {})
            .get("total_population")
        )

        print(
            "WORLDPOP POPULATION:",
            population,
            "AT:",
            latitude,
            longitude,
        )

        if population is None:
            print(
                "WORLDPOP: total_population not found"
            )

            return None

        return float(population)

    except Exception as error:

        print(
            "WORLDPOP REQUEST ERROR:",
            repr(error),
        )

        return None


async def get_cached_worldpop_population(
