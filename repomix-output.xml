) -> float | None:

    # Round coordinates so extremely tiny coordinate
    # differences don't create unnecessary API requests.
    cache_key = (
        round(latitude, 3),
        round(longitude, 3),
    )

    if cache_key in WORLDPOP_CACHE:
        return WORLDPOP_CACHE[cache_key]

    population = await get_worldpop_population(
        latitude,
        longitude,
