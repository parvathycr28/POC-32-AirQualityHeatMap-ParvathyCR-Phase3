  --color-foreground: var(--foreground);

  --color-surface: var(--surface);
  --color-surface-elevated: var(--surface-elevated);

  --color-accent: var(--accent);
  --color-accent-secondary: var(--accent-secondary);

  --color-border: var(--border);
  --color-muted: var(--muted);

  --font-sans: Arial, Helvetica, sans-serif;
}

* {
  box-sizing: border-box;
}

html,
body {
  min-height: 100%;
  margin: 0;
  padding: 0;
  background: #030712;
  color: #e5f3f8;
}

body {
  font-family: Arial, Helvetica, sans-serif;
}

button,
select,
input {
  font: inherit;
}

button,
select {
  outline: none;
}

button:focus-visible,
select:focus-visible,
input:focus-visible {
  outline: 1px solid #38bdf8;
  outline-offset: 3px;
}

/* Scrollbar */

::-webkit-scrollbar {
  width: 6px;
  height: 6px;
}

::-webkit-scrollbar-track {
  background: #030712;
}

::-webkit-scrollbar-thumb {
  background: #1f2937;
  border-radius: 999px;
}

::-webkit-scrollbar-thumb:hover {
  background: #38bdf8;
}

/* Selection */

::selection {
  background: rgba(56, 189, 248, 0.25);
  color: #ffffff;
}

/* Leaflet */

.leaflet-container {
  width: 100%;
  height: 100%;
  background: #071521;
  font-family: Arial, Helvetica, sans-serif;
}

.leaflet-control-zoom a,
.leaflet-control-layers {
  background: #0b1117 !important;
  color: #e5f3f8 !important;
  border-color: #1f2937 !important;
}

.leaflet-control-zoom a:hover {
  background: #102631 !important;
  color: #38bdf8 !important;
}

.leaflet-popup-content-wrapper,
.leaflet-popup-tip {
  background: #0b1117;
  color: #e5f3f8;
  border: 1px solid #1f2937;
}

.leaflet-popup-content {
  margin: 14px;
}

.leaflet-popup-close-button {
  color: #8ba3b0 !important;
}

.leaflet-popup-close-button:hover {
  color: #38bdf8 !important;
}

/* Map attribution */

.leaflet-control-attribution {
  background: rgba(3, 7, 18, 0.8) !important;
  color: #8ba3b0 !important;
}

.leaflet-control-attribution a {
  color: #38bdf8 !important;
}

/* Interactive glow */

.rr-interactive {
  transition:
    border-color 180ms ease,
    box-shadow 180ms ease,
    color 180ms ease;
}

.rr-interactive:hover {
  border-color: #38bdf8;
  box-shadow: 0 0 8px rgba(56, 189, 248, 0.12);
}

/* Glass surface */

.rr-glass {
  background: rgba(11, 17, 23, 0.88);
  border: 1px solid #1f2937;
  backdrop-filter: blur(14px);
}

/* Utility */

.rr-muted {
  color: #8ba3b0;
}

.rr-cyan {
  color: #38bdf8;
}

.rr-indigo {
  color: #818cf8;
}
/* =========================================================
   REAL RAILS - CINEMATIC LEAFLET BASEMAP
   Darkens ONLY the map tile layer.
   Markers, controls and popups remain unaffected.
   ========================================================= */

.leaflet-container {
  background: #030712 !important;
}

.leaflet-tile-pane {
  filter:
    brightness(0.98)
    invert(0.92)
    contrast(1.15)
    saturate(0.35)
    hue-rotate(180deg);
}
/* =========================================================
   REAL RAILS - COMPACT DARK CITY POPUP
   ========================================================= */

.leaflet-popup-content-wrapper {
  background: #0B1117 !important;
  color: #E5F3F8 !important;
  border: 1px solid #26384A !important;
  border-radius: 10px !important;
  box-shadow: 0 12px 30px rgba(0, 0, 0, 0.65) !important;
}

/* Popup arrow */
.leaflet-popup-tip {
  background: #0B1117 !important;
}

/* Smaller popup */
.leaflet-popup-content {
  width: 240px !important;
  max-width: 240px !important;
  margin: 12px 14px !important;
}

/* Close button */
.leaflet-popup-close-button {
  color: #E5F3F8 !important;
  font-size: 20px !important;
  font-weight: 600 !important;
  padding: 6px 8px 0 0 !important;
}

.leaflet-popup-close-button:hover {
  color: #38BDF8 !important;
}

/* Popup text */
.leaflet-popup-content p {
  margin: 0 !important;
}

/* Labels */
.leaflet-popup-content .popup-label {
  color: #94AFC0 !important;
  font-size: 11px !important;
}

/* Main values */
.leaflet-popup-content .popup-value {
  color: #F1F5F9 !important;
  font-size: 14px !important;
  font-weight: 500 !important;
}

/* Cyan highlighted values */
.leaflet-popup-content .popup-accent {
  color: #38BDF8 !important;
  font-weight: 600 !important;
}

/* City name */
.leaflet-popup-content .popup-title {
  color: #F8FAFC !important;
  font-size: 16px !important;
  font-weight: 700 !important;
  line-height: 1.25 !important;
}

/* Air Quality heading */
.leaflet-popup-content .popup-heading {
  color: #38BDF8 !important;
  font-size: 10px !important;
  font-weight: 600 !important;
  letter-spacing: 0.12em !important;
  text-transform: uppercase !important;
}

/* Load population */
.leaflet-popup-content button {
  color: #38BDF8 !important;
}
