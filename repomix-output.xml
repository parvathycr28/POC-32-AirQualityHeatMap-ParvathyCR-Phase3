]


def clean_entity_id(value):
    return (
        str(value)
        .strip()
        .lower()
        .replace(" ", "_")
        .replace("-", "_")
    )


def main():
    if not INPUT_FILE.exists():
        raise FileNotFoundError(
            f"Source sample not found: {INPUT_FILE}"
        )

