    )

    timestamp_counts_per_group = city_pollutant_timestamp.groupby(
        ["city", "pollutant"]
    )["timestamp"].nunique()

    groups_with_expected_timestamp_count = int(
        (timestamp_counts_per_group == expected_timestamps_per_group).sum()
    )

