              {properties.fallback && (
                <p className="mt-4 rounded-lg border border-yellow-900/50 bg-yellow-950/20 p-3 text-xs text-yellow-300">
                  Fallback data is being displayed.
                </p>
              )}
            </section>
          </>
        )}
      </div>
    </aside>
  );
}
