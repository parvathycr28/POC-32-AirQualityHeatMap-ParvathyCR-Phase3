def percentage_difference(
    value: float,
    reference: float,
) -> float:
    if reference == 0:
        return 0

    return round(
        ((value - reference) / reference) * 100,
        1,
    )

def calculate_exposure_score(
    value: float,
    score_reference: float,
) -> int:
    if score_reference <= 0:
        return 0

    score = (value / score_reference) * 50

    return max(
        0,
        min(
            100,
            round(score),
        ),
    )

   

    return max(
        0,
        min(
            100,
            round(score),
        ),
    )


